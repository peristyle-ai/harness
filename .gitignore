# Per-agent pie directory — each agent (wisp, evie) is its own self-contained
# git repo under pie/<agent>/, with its own .git/ in place. The harness repo
# only tracks the shared harness code; per-agent content lives in
# peristyle-ai/<agent> repos.
pie/
.env.bak-*
# Local backups from the 2026-10-19 z.ai dispatch work
.env.bak-2026-10-19-timeouts
.env.bak-2026-10-19-thinking
.env.bak.*
.env.*.bak
*.env.bak.*
run.sh.bak-2026-10-19-timeouts
config.yaml.bak-2026-10-19-thinking
app/config.py.bak-2026-10-19-thinking
.bak-2026-10-19-zai-dispatch/
test_repair_tmp.py
uploads/

# Per-customer install configs: they carry API keys, so they are never tracked.
# The tracked example is install/peribot.example.yaml.
install/*.yaml
!install/peribot.example.yaml
