# Python profiling
.prof

# Per-agent pie directory — each agent is its own self-contained
# git repo under pie/<agent>/, with its own .git/ in place. The harness repo
# only tracks the shared harness code; per-agent content lives in
# that agent's own repo.
pie/
.env.bak-*
# Local backups from the 2026-10-19 z.ai dispatch work
.env.bak-2026-10-19-timeouts
.env.bak-2026-10-19-thinking
.env.bak.*
.env.*.bak
*.env.bak.*
run.sh.bak-2026-10-19-timeouts
config.yaml.bak-2026-10-19-thinking
app/config.py.bak-2026-10-19-thinking
.bak-2026-10-19-zai-dispatch/
test_repair_tmp.py
uploads/

# Per-customer install material: a prepared config.yaml carries the
# customer's API keys and passwords, so the whole folder is local-only.
# It is untracked because the tracked tree must not carry a customer's
# install -- and because a prepared install is ONE file (config.yaml),
# not a folder of per-customer yaml.
install/

# The install's own config. config.yaml.example IS tracked (it is the
# template); config.yaml is not -- it is this install's copy, edited in
# place, and it may carry per-install values.
config.yaml

# Generated per-agent schema by tools/apply_install_config.py.
schema/*_schema.sql

# --- Runtime content and internal working notes (untracked 2026-10-26) ---

# Entity icons (agent avatars) are UPLOADED at runtime through
# PUT /api/v1/entities/<name>/icon and stored here. They are user
# content, not source: they are per-install, and the filename carries
# the agent name of whoever runs the install. The GET endpoint already
# handles a missing file (404 + a log line), so a fresh clone simply
# has no avatars and the UI falls back to the default one.
# Note: the contents are ignored, not the directory itself, so the
# README.md below survives and documents the directory's purpose.
app/static/entity-icons/*
!app/static/entity-icons/README.md

# Internal working documents. These are dated plans for a specific
# install (per-agent schemas, tunnel IDs, host paths); they are not
# contributor documentation, and they go stale the moment the work
# they describe lands. The design that actually shipped lives in the
# README, in the code, and in schema/.
docs/
REQUIREMENTS_AND_SPECIFICATIONS.md
