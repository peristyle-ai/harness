# The harness service, for systemd --user.
#
#   mkdir -p ~/.config/systemd/user
#   cp systemd/harness.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now harness.service
#
# The paths are relative to the install directory, which is where this file
# lives -- so a checkout in /opt/harness works unchanged:
#
#   install dir  = the directory containing run.sh
#   working dir  = <install dir>
#   config file  = <install dir>/config.yaml
#
# There is no EnvironmentFile: the configuration and the secrets live in
# config.yaml, which the app reads at startup. It must be mode 0600.
#
# To install somewhere else, edit the paths below.
[Unit]
Description=Peristyle Harness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/harness
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/harness/run.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
