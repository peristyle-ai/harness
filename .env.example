# Flask
HARNESS_SECRET_KEY=
HARNESS_BIND=0.0.0.0:5010
HARNESS_TLS_CERT=/opt/harness/tls/cert.pem
HARNESS_TLS_KEY=/opt/harness/tls/key.pem
FLASK_ENV=production
PYTHONUNBUFFERED=1

# Postgres
DATABASE_URL=postgresql://harness_app:REPLACE_ME@localhost:5432/harness
APP_DB_OPERATOR_ROLE=peristyle
APP_DB_RUNTIME_ROLE=harness_app
HARNESS_DB=harness

# The password of the OPERATOR role -- the one that OWNS the schema and
# applies it (tools/migrate.sh). It is NOT the password in DATABASE_URL
# (that is the runtime role's, which may only do DML).
#
# Leave it empty when the operator connects over the unix socket with peer
# auth, which needs no password: the OS user must be the role's name. Set it
# when the operator connects over TCP (a remote database, or an OS user that
# is not the role's name).
APP_DB_OPERATOR_PASSWORD=

# The database that HOLDS the agent schemas, and where the per-pie
# directory lives. Both default to the install's own layout, so they are
# normally left as they are.
HARNESS_INSTALLATION_DATABASE=harness
HARNESS_PIE_ROOT=pie

# Agent
HARNESS_DEFAULT_AGENT=wisp

# LLM (per-installation; adapter module + key)
LLM_ADAPTER=minimax_m3
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_MODEL=MiniMax-M3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.7

# Per-agent LLM overrides.
#
# config.yaml's llm.per_agent block names one agent per entry, and each
# entry REPLACES the global llm: block above wholesale -- so every field
# must be present. An agent with no entry falls through to the global block.
#
# A single-agent install (what tools/apply_install_config.py writes) has no
# per_agent block at all, and these are then unused.
WISP_LLM_ADAPTER=minimax_m3
WISP_LLM_API_KEY=
WISP_LLM_BASE_URL=https://api.minimax.io/anthropic
WISP_LLM_MODEL=MiniMax-M3
WISP_LLM_MAX_TOKENS=2048
WISP_LLM_TIMEOUT_S=60
WISP_LLM_TEMPERATURE=0.7
WISP_LLM_THINKING=
EVIE_LLM_ADAPTER=minimax_m3
EVIE_LLM_API_KEY=
EVIE_LLM_BASE_URL=https://api.minimax.io/anthropic
EVIE_LLM_MODEL=MiniMax-M3
EVIE_LLM_MAX_TOKENS=2048
EVIE_LLM_TIMEOUT_S=60
EVIE_LLM_TEMPERATURE=0.7
EVIE_LLM_THINKING=
CLAWBIE_LLM_ADAPTER=minimax_m3
CLAWBIE_LLM_API_KEY=
CLAWBIE_LLM_BASE_URL=https://api.minimax.io/anthropic
CLAWBIE_LLM_MODEL=MiniMax-M3
CLAWBIE_LLM_MAX_TOKENS=2048
CLAWBIE_LLM_TIMEOUT_S=60
CLAWBIE_LLM_TEMPERATURE=0.7
CLAWBIE_LLM_THINKING=

# Embeddings.
#
# Either the LOCAL GPU server (the default on our own machines):
#   EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
#   EMBEDDING_API_KEY=                (the local server takes no key)
#
# or a REMOTE embedding service (no GPU needed here). The key is sent as
# "Authorization: Bearer <key>" on every request:
#   EMBEDDING_BASE_URL=https://embed.example.com/v1
#   EMBEDDING_API_KEY=ep_...
#
# The request body is OpenAI-compatible either way, so the two are
# interchangeable.
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_S=10

# Memory tuning
MEMORY_TOP_K=10
MEMORY_VECTOR_LIMIT=30
MEMORY_TRIGRAM_LIMIT=30
MEMORY_RECENCY_DECAY_DAYS=30
MEMORY_CHUNK_MAX_TOKENS=800
MEMORY_CHUNK_MIN_TOKENS=20
MEMORY_CHUNK_OVERLAP_TOKENS=50

# Permanent memory (injected every prompt)
MEMORY_PERMANENT_MAX_TOKENS=10000
MEMORY_PERMANENT_WARN_OVERFLOW=true
MEMORY_PERMANENT_PIN_AUDIT=true

# Workspace bootstrap files (per-file caps; hard fail on overflow)
BOOTSTRAP_SOUL_MAX_BYTES=8000
BOOTSTRAP_USER_MAX_BYTES=4000
BOOTSTRAP_AGENTS_MAX_BYTES=24000
BOOTSTRAP_IDENTITY_MAX_BYTES=8000
BOOTSTRAP_MEMORY_MAX_BYTES=65536
BOOTSTRAP_OVERFLOW=fail

# Conditional system-prompt pressure warnings (2026-10-22). When an
# identity file or the permanent-memory block passes this fraction of
# its cap, the agent is told to move the detail out of it.
PROMPT_PRESSURE_ENABLED=true
PROMPT_PRESSURE_THRESHOLD=0.85

# Nightly reverie (2026-10-23). A real agent turn (captured in the
# turns table) that asks the agent to clean up its own context budget
# down to the target percentages, then reflect and put proposals to the
# user in chat. It only fires if the agent had activity in the window.
REVERIE_ENABLED=false
# Empty = every installed agent. Otherwise a comma-separated list.
REVERIE_AGENTS=
# Nightly time of day (local to REVERIE_TIMEZONE).
REVERIE_AT=03:00
REVERIE_TIMEZONE=Australia/Brisbane
# Targets as a fraction of each cap (0.60 leaves headroom below the
# 0.85 prompt-pressure warning).
REVERIE_FILE_TARGET_PCT=0.60
REVERIE_MEMORY_TARGET_PCT=0.60
# Only fire if the agent had activity in this window.
REVERIE_ACTIVITY_WINDOW_HOURS=24
# The DM partner the reverie turn runs as.
REVERIE_USER_EMAIL=
# Optional per-agent instruction file (relative to pie/<agent>/identity/).
REVERIE_PROMPT_FILE=REVERIE.md
# Identity files the reverie must NOT edit (user permission only).
REVERIE_PROTECTED_FILES=SOUL.md
# Optional cap on the tool iterations of one reverie turn (0 = use the
# global agent.max_tool_iterations).
REVERIE_MAX_TOOL_ITERATIONS=0

# Agent loop invariants
MAX_TOOL_ITERATIONS=25
MAX_SEARCHES_PER_TURN=15
MAX_PINS_PER_TURN=10
MAX_UNPINS_PER_TURN=10

# Wall-clock cap for ONE turn, in seconds (0 = no cap). The iteration cap
# is the primary guard; this is the backstop for a slow turn. 5 hours.
MAX_TURN_SECONDS=18000

# Token budget for the LIVE part of one turn (the messages the loop
# replays on every model call). Over budget, the OLDEST iterations of the
# turn are dropped and the model is told, in the system prompt, that its
# tail was truncated -- so it recovers the trajectory from its memory
# tools and its commits. MiniMax-M3.1-Flash's window is 1,000,000 tokens.
CONTEXT_WINDOW_TOKENS=600000

# Head/tail trim for tool output sent to the MODEL. The tail matters most:
# it is where the result and the error message are. The full output still
# goes into the trajectory (the retraining corpus).
TOOL_OUTPUT_HEAD_CHARS=4000
TOOL_OUTPUT_TAIL_CHARS=4000

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_MEMORY=60/minute

# Security headers
SECURITY_HSTS_MAX_AGE=15552000
HARNESS_INTERNAL_TOKEN=replace-me-with-a-random-token-32-chars-min

# -----------------------------------------------------------------------------
# Per-pie secrets (harness-wide fallback, NOT required for pie-specific keys)
# -----------------------------------------------------------------------------
# The harness-wide harness/.env is for shared infrastructure secrets only
# (LLM keys, DB URLs, TLS, rate limits). Secrets that should be scoped to a
# single pie (e.g. a single agent's email credentials) live in that pie's
# own .env file at:
#
#     pie/<pie_name>/.env
#
# Each pie's .env is loaded by its own env_loader.py with override=False, so
# values already in the process environment (from harness/.env at startup)
# still win. See SECURITY.md for the full rules and mode requirements.
